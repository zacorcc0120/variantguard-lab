{
  "name": "variantguard-lab",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Browser-only Shopify product CSV overwrite-import risk checker. No server, no shop connection, no telemetry.",
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.28",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.15.3",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "^9.39.5",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "@tailwindcss/oxide@4.1.13": true,
    "unrs-resolver@1.12.2": true
  }
}
